# Simple toilet model: bowl (cube) and tank (box)
# bowl cube centered at origin, size 1
o bowl
v -0.5 -0.25 -0.5
v 0.5 -0.25 -0.5
v 0.5 0.25 -0.5
v -0.5 0.25 -0.5
v -0.5 -0.25 0.5
v 0.5 -0.25 0.5
v 0.5 0.25 0.5
v -0.5 0.25 0.5
